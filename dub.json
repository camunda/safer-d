{
  "name": "safer-d",
  "description": "Safer D: the shared safety rules, checker and @safe building blocks for Camunda's D projects",
  "license": "Apache-2.0",
  "authors": [
    "Camunda"
  ],
  "copyright": "Copyright © Camunda Services GmbH",
  "targetType": "library",
  "sourcePaths": [
    "source"
  ],
  "importPaths": [
    "source"
  ],
  "toolchainRequirements": {
    "dmd": "no",
    "gdc": "no",
    "ldc": ">=1.43.0"
  },
  "dflags": [
    "-allinst",
    "-preview=dip1000",
    "-preview=nosharedaccess"
  ],
  "dflags-ldc": [
    "-fno-delete-null-pointer-checks"
  ],
  "buildTypes": {
    "release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "dflags-ldc": [
        "-boundscheck=on"
      ]
    }
  },
  "subPackages": [
    {
      "name": "check",
      "description": "safer-d-check: checks a D project against the Safer D rules",
      "targetType": "executable",
      "targetName": "safer-d-check",
      "sourcePaths": [
        "check/source"
      ],
      "importPaths": [
        "check/source"
      ],
      "dependencies": {
        "safer-d": "*"
      },
      "toolchainRequirements": {
        "dmd": "no",
        "gdc": "no",
        "ldc": ">=1.43.0"
      },
      "dflags": [
        "-allinst",
        "-preview=dip1000",
        "-preview=nosharedaccess"
      ],
      "dflags-ldc": [
        "-fno-delete-null-pointer-checks"
      ],
      "buildTypes": {
        "release": {
          "buildOptions": [
            "releaseMode",
            "optimize",
            "inline"
          ],
          "dflags-ldc": [
            "-boundscheck=on",
            "-link-defaultlib-shared=false"
          ]
        }
      },
      "stringImportPaths": [
        "templates"
      ]
    }
  ]
}
